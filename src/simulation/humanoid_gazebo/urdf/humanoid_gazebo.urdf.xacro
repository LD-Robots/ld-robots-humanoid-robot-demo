<?xml version="1.0"?>
<robot name="humanoid_gazebo" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== PARAMETERS ==================== -->
  <xacro:arg name="use_sim" default="true"/>
  <xacro:arg name="prefix" default=""/>

  <xacro:property name="use_sim" value="$(arg use_sim)"/>
  <xacro:property name="prefix" value="$(arg prefix)"/>

  <!-- ==================== MATERIALS ==================== -->

  <!-- Import materials from robot_description -->
  <xacro:include filename="$(find humanoid_description)/xacro/common/materials.xacro"/>

  <!-- Add missing "dark" material -->
  <material name="dark">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <!-- ==================== IMPORT ROBOT LINKS AND JOINTS ==================== -->

  <!-- Import links from robot_description -->
  <xacro:include filename="$(find humanoid_description)/xacro/links/robot_links.xacro"/>

  <!-- Import joints from robot_description -->
  <xacro:include filename="$(find humanoid_description)/xacro/joints/robot_joints.xacro"/>

  <!-- Import ros2_control configuration -->
  <xacro:include filename="$(find humanoid_gazebo)/urdf/ros2_control.xacro"/>

  <!-- Import Gazebo plugins -->
  <xacro:include filename="$(find humanoid_gazebo)/urdf/gazebo.xacro"/>

  <!-- ==================== GAZEBO-SPECIFIC ADDITIONS ==================== -->

  <!-- Base link for Gazebo -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>

  <!-- Fixed joint from base_link to pelvis -->
  <joint name="base_link_to_pelvis" type="fixed">
    <parent link="base_link"/>
    <child link="pelvis"/>
    <origin xyz="0 0 0.813" rpy="0 0 0"/>
  </joint>

  <!-- ==================== INSTANTIATE ROS2 CONTROL ==================== -->
  <xacro:humanoid_ros2_control use_sim="${use_sim}" prefix="${prefix}"/>

  <!-- ==================== INSTANTIATE GAZEBO PLUGINS ==================== -->
  <xacro:humanoid_gazebo_plugins/>

</robot>

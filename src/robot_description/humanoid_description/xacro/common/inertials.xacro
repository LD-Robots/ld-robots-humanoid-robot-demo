<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Inertial property macros -->

  <!-- Macro for box inertia -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0.0" ixz="0.0"
               iyy="${m*(x*x+z*z)/12}" iyz="0.0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <!-- Macro for cylinder inertia -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0.0" ixz="0.0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0.0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <!-- Macro for sphere inertia -->
  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5}" ixy="0.0" ixz="0.0"
               iyy="${2*m*r*r/5}" iyz="0.0"
               izz="${2*m*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <!-- Macro for custom inertia (when you have measured values) -->
  <xacro:macro name="custom_inertia" params="m ixx ixy ixz iyy iyz izz">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}"
               iyy="${iyy}" iyz="${iyz}"
               izz="${izz}"/>
    </inertial>
  </xacro:macro>

  <!-- Macro for point mass (negligible inertia) -->
  <xacro:macro name="point_mass" params="m">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>
  </xacro:macro>

</robot>

<?xml version="1.0"?>
<mujoco model="simple_humanoid">
  <option timestep="0.002" iterations="50" solver="Newton" gravity="0 0 -9.81"/>

  <asset>
    <texture name="texplane" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" width="512" height="512"/>
    <material name="matplane" reflectance="0.3" texture="texplane" texrepeat="1 1"/>
  </asset>

  <worldbody>
    <!-- Ground plane -->
    <geom name="floor" type="plane" size="10 10 0.1" material="matplane"/>
    <light directional="true" diffuse="0.8 0.8 0.8" pos="0 0 5" dir="0 0 -1"/>

    <!-- Floating base humanoid robot -->
    <body name="torso" pos="0 0 0.89">
      <freejoint name="root"/>
      <geom name="torso_geom" type="box" size="0.12 0.08 0.25" mass="5.0" rgba="0.6 0.6 0.6 1"/>
      <geom name="head" type="sphere" size="0.08" pos="0 0 0.33" mass="1.0" rgba="0.8 0.8 0.8 1"/>

      <!-- Left leg -->
      <body name="left_hip" pos="0 0.06 -0.20">
        <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
        <joint name="left_hip_yaw" type="hinge" axis="0 0 1" range="-0.5 0.5"/>
        <body name="left_hip2" pos="0 0 0">
          <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
          <joint name="left_hip_roll" type="hinge" axis="0 1 0" range="-0.3 0.8"/>
          <body name="left_hip3" pos="0 0 0">
            <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
            <joint name="left_hip_pitch" type="hinge" axis="1 0 0" range="-1.57 1.57"/>
            <geom name="left_thigh" type="capsule" size="0.04" fromto="0 0 0 0 0 -0.212" mass="1.5" rgba="0.4 0.6 0.8 1"/>

            <body name="left_knee" pos="0 0 -0.212">
              <joint name="left_knee" type="hinge" axis="1 0 0" range="0 2.5"/>
              <geom name="left_shin" type="capsule" size="0.035" fromto="0 0 0 0 0 -0.240" mass="1.0" rgba="0.3 0.5 0.7 1"/>

              <body name="left_ankle" pos="0 0 -0.240">
                <joint name="left_ankle" type="hinge" axis="1 0 0" range="-0.7 0.7"/>
                <geom name="left_foot" type="box" size="0.08 0.04 0.02" pos="0.02 0 -0.02" mass="0.5" rgba="0.2 0.2 0.2 1"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- Right leg -->
      <body name="right_hip" pos="0 -0.06 -0.20">
        <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
        <joint name="right_hip_yaw" type="hinge" axis="0 0 1" range="-0.5 0.5"/>
        <body name="right_hip2" pos="0 0 0">
          <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
          <joint name="right_hip_roll" type="hinge" axis="0 1 0" range="-0.8 0.3"/>
          <body name="right_hip3" pos="0 0 0">
            <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
            <joint name="right_hip_pitch" type="hinge" axis="1 0 0" range="-1.57 1.57"/>
            <geom name="right_thigh" type="capsule" size="0.04" fromto="0 0 0 0 0 -0.212" mass="1.5" rgba="0.4 0.6 0.8 1"/>

            <body name="right_knee" pos="0 0 -0.212">
              <joint name="right_knee" type="hinge" axis="1 0 0" range="0 2.5"/>
              <geom name="right_shin" type="capsule" size="0.035" fromto="0 0 0 0 0 -0.240" mass="1.0" rgba="0.3 0.5 0.7 1"/>

              <body name="right_ankle" pos="0 0 -0.240">
                <joint name="right_ankle" type="hinge" axis="1 0 0" range="-0.7 0.7"/>
                <geom name="right_foot" type="box" size="0.08 0.04 0.02" pos="0.02 0 -0.02" mass="0.5" rgba="0.2 0.2 0.2 1"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- Left arm -->
      <body name="left_shoulder" pos="0 0.14 0.20">
        <joint name="left_shoulder_pitch" type="hinge" axis="1 0 0" range="-2.0 2.0"/>
        <geom name="left_upper_arm" type="capsule" size="0.03" fromto="0 0 0 0 0 -0.15" mass="0.5" rgba="0.5 0.5 0.5 1"/>
        <body name="left_elbow" pos="0 0 -0.15">
          <joint name="left_elbow" type="hinge" axis="1 0 0" range="0 2.5"/>
          <geom name="left_forearm" type="capsule" size="0.025" fromto="0 0 0 0 0 -0.15" mass="0.3" rgba="0.4 0.4 0.4 1"/>
        </body>
      </body>

      <!-- Right arm -->
      <body name="right_shoulder" pos="0 -0.14 0.20">
        <joint name="right_shoulder_pitch" type="hinge" axis="1 0 0" range="-2.0 2.0"/>
        <geom name="right_upper_arm" type="capsule" size="0.03" fromto="0 0 0 0 0 -0.15" mass="0.5" rgba="0.5 0.5 0.5 1"/>
        <body name="right_elbow" pos="0 0 -0.15">
          <joint name="right_elbow" type="hinge" axis="1 0 0" range="0 2.5"/>
          <geom name="right_forearm" type="capsule" size="0.025" fromto="0 0 0 0 0 -0.15" mass="0.3" rgba="0.4 0.4 0.4 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Actuators -->
  <actuator>
    <!-- Legs -->
    <position name="left_hip_yaw_act" joint="left_hip_yaw" kp="100"/>
    <position name="left_hip_roll_act" joint="left_hip_roll" kp="100"/>
    <position name="left_hip_pitch_act" joint="left_hip_pitch" kp="100"/>
    <position name="left_knee_act" joint="left_knee" kp="100"/>
    <position name="left_ankle_act" joint="left_ankle" kp="100"/>

    <position name="right_hip_yaw_act" joint="right_hip_yaw" kp="100"/>
    <position name="right_hip_roll_act" joint="right_hip_roll" kp="100"/>
    <position name="right_hip_pitch_act" joint="right_hip_pitch" kp="100"/>
    <position name="right_knee_act" joint="right_knee" kp="100"/>
    <position name="right_ankle_act" joint="right_ankle" kp="100"/>

    <!-- Arms -->
    <position name="left_shoulder_act" joint="left_shoulder_pitch" kp="50"/>
    <position name="left_elbow_act" joint="left_elbow" kp="50"/>
    <position name="right_shoulder_act" joint="right_shoulder_pitch" kp="50"/>
    <position name="right_elbow_act" joint="right_elbow" kp="50"/>
  </actuator>
</mujoco>

 <sensor name="thermal_camera" type="thermal">
        <pose>0.44 -0.17 0.574 0 0 0</pose>
        <camera name="thermal_camera">
          <horizontal_fov>0.628</horizontal_fov>
          <lens>
            <intrinsics>
              <!-- fx = fy = width / ( 2 * tan (hfov / 2 ) ) -->
              <fx>317.173</fx>
              <fy>317.173</fy>
              <!-- cx = ( width - 1 ) / 2 -->
              <cx>102.5</cx>
              <!-- cy = ( height - 1 ) / 2 -->
              <cy>77.5</cy>
              <s>0</s>
            </intrinsics>
          </lens>
          <image>
            <width>206</width>
            <height>156</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>9</update_rate>
        <plugin
          filename="gz-sim-thermal-sensor-system"
          name="gz::sim::systems::ThermalSensor">
          <min_temp>253.15</min_temp>
          <max_temp>673.15</max_temp>
          <resolution>1.6</resolution>
        </plugin>
      </sensor>
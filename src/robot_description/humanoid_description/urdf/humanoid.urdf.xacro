<?xml version="1.0"?>
<robot name="humanoid" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== INCLUDES ==================== -->

  <!-- Common properties and macros -->
  <xacro:include filename="$(find humanoid_description)/xacro/common/materials.xacro"/>
  <xacro:include filename="$(find humanoid_description)/xacro/common/inertials.xacro"/>
  <xacro:include filename="$(find humanoid_description)/xacro/common/transmission.xacro"/>
  <xacro:include filename="$(find humanoid_description)/xacro/joints/robot_joints.xacro"/>
  <xacro:include filename="$(find humanoid_description)/xacro/links/robot_links.xacro"/>
  <!-- Robot components -->
  <!-- TODO: Uncomment as xacro files are created
  <xacro:include filename="$(find humanoid_description)/xacro/torso/torso.xacro"/>
  <xacro:include filename="$(find humanoid_description)/xacro/head/head.xacro"/>
  <xacro:include filename="$(find humanoid_description)/xacro/arms/arm.xacro"/>
  <xacro:include filename="$(find humanoid_description)/xacro/hands/hand.xacro"/>
  <xacro:include filename="$(find humanoid_description)/xacro/legs/leg.xacro"/>
  <xacro:include filename="$(find humanoid_description)/xacro/sensors/cameras.xacro"/>
  <xacro:include filename="$(find humanoid_description)/xacro/sensors/imu.xacro"/>
  <xacro:include filename="$(find humanoid_description)/xacro/sensors/force_torque.xacro"/>
  -->

  <!-- ==================== PARAMETERS ==================== -->

  <!-- Global parameters -->
  <xacro:property name="PI" value="3.14159265359"/>

  <!-- Robot dimensions (placeholder values - adjust based on actual robot) -->
  <xacro:property name="torso_height" value="0.5"/>
  <xacro:property name="torso_width" value="0.3"/>
  <xacro:property name="torso_depth" value="0.2"/>

  <!-- Joint limits (placeholder values) -->
  <xacro:property name="joint_damping" value="0.5"/>
  <xacro:property name="joint_friction" value="0.1"/>
  <xacro:property name="joint_effort_limit" value="100.0"/>
  <xacro:property name="joint_velocity_limit" value="2.0"/>

  <!-- ==================== BASE LINK ==================== -->

 <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>

  <!-- Fixed joint from base_link to base (leg structure root) -->
  <!-- This joint lifts the leg structure so feet are at ground level (z=0) -->
  <joint name="base_link_to_base" type="fixed">
    <parent link="base_link"/>
    <child link="base"/>
    <origin xyz="0 0 0.813" rpy="0 0 0"/>
  </joint>

  <!-- ==================== COMPONENT INSTANTIATION ==================== -->

  <!-- TODO: Instantiate robot components here -->

  <!-- Torso/Spine -->
  <!-- <xacro:torso parent="base_link"/> -->

  <!-- Head -->
  <!-- <xacro:head parent="torso_upper_link"/> -->

  <!-- Left Arm -->
  <!-- <xacro:arm prefix="left" parent="torso_upper_link">
    <origin xyz="0 0.15 0.4" rpy="0 0 0"/>
  </xacro:arm> -->

  <!-- Right Arm -->
  <!-- <xacro:arm prefix="right" parent="torso_upper_link">
    <origin xyz="0 -0.15 0.4" rpy="0 0 0"/>
  </xacro:arm> -->

  <!-- Left Hand -->
  <!-- <xacro:hand prefix="left" parent="left_wrist_link">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:hand> -->

  <!-- Right Hand -->
  <!-- <xacro:hand prefix="right" parent="right_wrist_link">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:hand> -->

  <!-- Left Leg -->
  <!-- <xacro:leg prefix="left" parent="base_link">
    <origin xyz="0 0.1 0" rpy="0 0 0"/>
  </xacro:leg> -->

  <!-- Right Leg -->
  <!-- <xacro:leg prefix="right" parent="base_link">
    <origin xyz="0 -0.1 0" rpy="0 0 0"/>
  </xacro:leg> -->

  <!-- Sensors -->
  <!-- <xacro:cameras parent="head_link"/> -->
  <!-- <xacro:imu parent="torso_link"/> -->

  <!-- ==================== ROS2_CONTROL ==================== -->

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- Leg joints -->
    <joint name="dof_left_hip_pitch_04">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_left_hip_roll_03">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_left_hip_yaw_03">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_left_knee_04">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_left_ankle_02">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_right_hip_pitch_04">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_right_hip_roll_03">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_right_hip_yaw_03">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_right_knee_04">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_right_ankle_02">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Arm joints -->
    <joint name="dof_left_shoulder_pitch_03">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_left_shoulder_roll_03">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_left_shoulder_yaw_02">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_left_elbow_02">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_left_wrist_00">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_right_shoulder_pitch_03">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_right_shoulder_roll_03">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_right_shoulder_yaw_02">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_right_elbow_02">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="dof_right_wrist_00">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo ros2_control plugin -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find humanoid_gazebo)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>

<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Contact Sensor Macro
    Adds contact sensors to robot links (typically feet)
    for ground contact detection
  -->

  <xacro:macro name="contact_sensor" params="prefix link_name collision_name">

    <!-- Gazebo Contact Sensor -->
    <!-- Explicitly specify collision element to monitor -->
    <gazebo reference="${link_name}">
      <sensor name="${prefix}_contact_sensor" type="contact">
        <contact>
          <collision>${collision_name}</collision>
        </contact>
        <always_on>true</always_on>
        <update_rate>100.0</update_rate>
        <visualize>true</visualize>
        <topic>/${prefix}_foot/contact</topic>
      </sensor>
    </gazebo>

  </xacro:macro>

  <!--
    Bumper/Contact Sensor with multiple collision elements
    Useful for more complex contact detection
  -->
  <xacro:macro name="bumper_sensor" params="prefix link_name *collision_elements">

    <gazebo reference="${link_name}">
      <sensor name="${prefix}_bumper_sensor" type="contact">
        <contact>
          <xacro:insert_block name="collision_elements"/>
          <topic>/${prefix}_bumper/contact</topic>
        </contact>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact">
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>

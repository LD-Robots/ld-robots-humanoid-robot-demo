<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="head" params="parent">

    <!-- Head properties -->
    <xacro:property name="head_radius" value="0.10"/>
    <xacro:property name="neck_length" value="0.08"/>
    <xacro:property name="head_mass" value="2.0"/>
    <xacro:property name="neck_mass" value="0.5"/>

    <!-- Neck pitch joint -->
    <joint name="neck_pitch" type="revolute">
      <parent link="${parent}"/>
      <child link="neck_link"/>
      <origin xyz="0 0 ${0.5/2 + 0.04}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="30" lower="-0.785" upper="0.785" velocity="2.0"/>
      <dynamics damping="0.5" friction="0.0"/>
    </joint>

    <link name="neck_link">
      <visual>
        <geometry>
          <cylinder radius="0.04" length="${neck_length}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.04" length="${neck_length}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia mass="${neck_mass}" radius="0.04" length="${neck_length}"/>
    </link>

    <!-- Neck yaw joint -->
    <joint name="neck_yaw" type="revolute">
      <parent link="neck_link"/>
      <child link="head_link"/>
      <origin xyz="0 0 ${neck_length/2 + head_radius}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="30" lower="-1.57" upper="1.57" velocity="2.0"/>
      <dynamics damping="0.5" friction="0.0"/>
    </joint>

    <!-- Head link -->
    <link name="head_link">
      <visual>
        <geometry>
          <sphere radius="${head_radius}"/>
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${head_radius}"/>
        </geometry>
      </collision>
      <xacro:sphere_inertia mass="${head_mass}" radius="${head_radius}"/>
    </link>

  </xacro:macro>

</robot>

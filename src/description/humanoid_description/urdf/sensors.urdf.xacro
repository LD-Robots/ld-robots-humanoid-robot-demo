<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- IMU Sensor Macro -->
  <xacro:macro name="imu_sensor" params="parent">
    <joint name="imu_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="imu_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="imu_link">
      <visual>
        <geometry>
          <box size="0.03 0.03 0.01"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.03 0.03 0.01"/>
        </geometry>
      </collision>
      <xacro:box_inertia mass="0.05" x="0.03" y="0.03" z="0.01"/>
    </link>
  </xacro:macro>

  <!-- Camera Sensor Macro -->
  <xacro:macro name="camera_sensor" params="parent name">
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="0.08 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${name}_link">
      <visual>
        <geometry>
          <box size="0.02 0.06 0.02"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.02 0.06 0.02"/>
        </geometry>
      </collision>
      <xacro:box_inertia mass="0.1" x="0.02" y="0.06" z="0.02"/>
    </link>

    <!-- Optical frame -->
    <joint name="${name}_optical_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="${name}_optical_frame"/>
  </xacro:macro>

  <!-- Lidar Sensor Macro (optional) -->
  <xacro:macro name="lidar_sensor" params="parent name">
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>

    <link name="${name}_link">
      <visual>
        <geometry>
          <cylinder radius="0.04" length="0.05"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.04" length="0.05"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia mass="0.2" radius="0.04" length="0.05"/>
    </link>
  </xacro:macro>

</robot>

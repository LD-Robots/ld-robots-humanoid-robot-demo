<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Four-Point Foot Contact System

    Creates 4 independent contact points at the corners of the foot.
    Each contact point has:
    - Small spherical collision geometry
    - Soft contact parameters (compliant "bumper" behavior)
    - Contact sensor
    - Force-torque sensor

    This allows Gazebo to stabilize on all 4 points instead of just 3.

    Parameters:
    - prefix: "left" or "right"
    - parent: Parent link (main foot link)
    - foot_length: Front-to-back dimension of foot (default: 0.17m)
    - foot_width: Side-to-side dimension of foot (default: 0.08m)
    - contact_radius: Radius of contact spheres (default: 0.01m)
    - contact_offset_z: How far below foot to place contacts (default: -0.015m)
  -->

  <xacro:macro name="four_point_foot_contact" params="prefix parent foot_length:=0.17 foot_width:=0.08 contact_radius:=0.01 contact_offset_z:=-0.015">

    <!-- Define 4 corner positions relative to foot center -->
    <xacro:property name="front_x" value="${foot_length * 0.35}"/>  <!-- Front toe -->
    <xacro:property name="back_x" value="${-foot_length * 0.6}"/>   <!-- Heel -->
    <xacro:property name="left_y" value="${foot_width * 0.6}"/>
    <xacro:property name="right_y" value="${-foot_width * 0.6}"/>

    <!-- FRONT LEFT CONTACT -->
    <link name="${prefix}_foot_contact_fl">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000001" ixy="0" ixz="0"
                 iyy="0.000001" iyz="0"
                 izz="0.000001"/>
      </inertial>

      <visual>
        <geometry>
          <sphere radius="${contact_radius}"/>
        </geometry>
        <material name="contact_fl_material">
          <color rgba="1.0 0.2 0.2 0.9"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <sphere radius="${contact_radius}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_foot_contact_fl_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}_foot_contact_fl"/>
      <origin xyz="${front_x} ${left_y} ${contact_offset_z}" rpy="0 0 0"/>
    </joint>

    <!-- FRONT RIGHT CONTACT -->
    <link name="${prefix}_foot_contact_fr">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000001" ixy="0" ixz="0"
                 iyy="0.000001" iyz="0"
                 izz="0.000001"/>
      </inertial>

      <visual>
        <geometry>
          <sphere radius="${contact_radius}"/>
        </geometry>
        <material name="contact_fr_material">
          <color rgba="1.0 0.4 0.2 0.9"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <sphere radius="${contact_radius}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_foot_contact_fr_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}_foot_contact_fr"/>
      <origin xyz="${front_x} ${right_y} ${contact_offset_z}" rpy="0 0 0"/>
    </joint>

    <!-- BACK LEFT CONTACT -->
    <link name="${prefix}_foot_contact_bl">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000001" ixy="0" ixz="0"
                 iyy="0.000001" iyz="0"
                 izz="0.000001"/>
      </inertial>

      <visual>
        <geometry>
          <sphere radius="${contact_radius}"/>
        </geometry>
        <material name="contact_bl_material">
          <color rgba="0.2 0.2 1.0 0.9"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <sphere radius="${contact_radius}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_foot_contact_bl_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}_foot_contact_bl"/>
      <origin xyz="${back_x} ${left_y} ${contact_offset_z}" rpy="0 0 0"/>
    </joint>

    <!-- BACK RIGHT CONTACT -->
    <link name="${prefix}_foot_contact_br">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000001" ixy="0" ixz="0"
                 iyy="0.000001" iyz="0"
                 izz="0.000001"/>
      </inertial>

      <visual>
        <geometry>
          <sphere radius="${contact_radius}"/>
        </geometry>
        <material name="contact_br_material">
          <color rgba="0.2 0.4 1.0 0.9"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <sphere radius="${contact_radius}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_foot_contact_br_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}_foot_contact_br"/>
      <origin xyz="${back_x} ${right_y} ${contact_offset_z}" rpy="0 0 0"/>
    </joint>

    <!-- GAZEBO PROPERTIES FOR ALL 4 CONTACTS -->
    <!-- Soft, compliant contact parameters -->

    <gazebo reference="${prefix}_foot_contact_fl">
      <max_contacts>4</max_contacts>
      <collision>
        <surface>
          <contact>
            <ode>
              <kp>5000.0</kp>           <!-- Soft spring constant -->
              <kd>50.0</kd>             <!-- Damping -->
              <max_vel>0.1</max_vel>    <!-- Allow slow penetration -->
              <min_depth>0.005</min_depth>  <!-- 5mm penetration allowed -->
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <material>Gazebo/Red</material>
    </gazebo>

    <gazebo reference="${prefix}_foot_contact_fr">
      <max_contacts>4</max_contacts>
      <collision>
        <surface>
          <contact>
            <ode>
              <kp>5000.0</kp>
              <kd>50.0</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.005</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <material>Gazebo/Orange</material>
    </gazebo>

    <gazebo reference="${prefix}_foot_contact_bl">
      <max_contacts>4</max_contacts>
      <collision>
        <surface>
          <contact>
            <ode>
              <kp>5000.0</kp>
              <kd>50.0</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.005</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="${prefix}_foot_contact_br">
      <max_contacts>4</max_contacts>
      <collision>
        <surface>
          <contact>
            <ode>
              <kp>5000.0</kp>
              <kd>50.0</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.005</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <material>Gazebo/SkyBlue</material>
    </gazebo>

    <!-- CONTACT SENSORS FOR ALL 4 POINTS -->

    <!-- Front Left Contact Sensor -->
    <gazebo reference="${prefix}_foot_contact_fl">
      <sensor name="${prefix}_foot_contact_fl_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <contact>
          <collision>${prefix}_foot_contact_fl_collision</collision>
        </contact>
        <plugin filename="libgazebo_ros_bumper.so" name="gazebo_ros_bumper_fl">
          <ros>
            <namespace>/</namespace>
            <remapping>bumper_states:=${prefix}_foot/contact_fl</remapping>
          </ros>
          <frame_name>${prefix}_foot_contact_fl</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <!-- Front Right Contact Sensor -->
    <gazebo reference="${prefix}_foot_contact_fr">
      <sensor name="${prefix}_foot_contact_fr_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <contact>
          <collision>${prefix}_foot_contact_fr_collision</collision>
        </contact>
        <plugin filename="libgazebo_ros_bumper.so" name="gazebo_ros_bumper_fr">
          <ros>
            <namespace>/</namespace>
            <remapping>bumper_states:=${prefix}_foot/contact_fr</remapping>
          </ros>
          <frame_name>${prefix}_foot_contact_fr</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <!-- Back Left Contact Sensor -->
    <gazebo reference="${prefix}_foot_contact_bl">
      <sensor name="${prefix}_foot_contact_bl_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <contact>
          <collision>${prefix}_foot_contact_bl_collision</collision>
        </contact>
        <plugin filename="libgazebo_ros_bumper.so" name="gazebo_ros_bumper_bl">
          <ros>
            <namespace>/</namespace>
            <remapping>bumper_states:=${prefix}_foot/contact_bl</remapping>
          </ros>
          <frame_name>${prefix}_foot_contact_bl</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <!-- Back Right Contact Sensor -->
    <gazebo reference="${prefix}_foot_contact_br">
      <sensor name="${prefix}_foot_contact_br_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <contact>
          <collision>${prefix}_foot_contact_br_collision</collision>
        </contact>
        <plugin filename="libgazebo_ros_bumper.so" name="gazebo_ros_bumper_br">
          <ros>
            <namespace>/</namespace>
            <remapping>bumper_states:=${prefix}_foot/contact_br</remapping>
          </ros>
          <frame_name>${prefix}_foot_contact_br</frame_name>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
